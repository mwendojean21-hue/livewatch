# Copiez ce fichier en .env pour le développement local (jamais commité sur Git).
# En production sur Vercel, ces mêmes variables se règlent dans Project Settings
# → Environment Variables (sur le SERVICE "backend" si Vercel les sépare par
# service) — voir DEPLOIEMENT.md.

# --- Obligatoires : l'application refuse de démarrer sans elles ---
DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=generez-avec-python3-c-import-secrets-print-secrets-token-hex-32
ADMIN_PASSWORD=choisissez-un-mot-de-passe-fort

# --- Optionnelles (valeurs par défaut raisonnables si absentes) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=vous@example.com

# Origines autorisées en cross-origin. En production sur Vercel (Services),
# frontend et backend partagent un seul domaine : ce n'est donc utile qu'en
# développement local, quand le frontend Vite tourne sur son propre port.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Port d'écoute local uniquement (Vercel gère le sien automatiquement)
PORT=8001
